@@ -0,0 +1,71 @@
+name: Protected Workflow Integrity
+
+on:
+  pull_request_target:
+    types: [opened, edited, synchronize, reopened, ready_for_review]
+    branches:
+      - desarrollo
+      - certificacion
+      - main
+  pull_request_review:
+    types: [submitted, dismissed]
+
+concurrency:
+  group: protected-workflow-integrity-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+  pull-requests: read
+
+jobs:
+  workflow-integrity:
+    name: Protected Workflow Integrity
+    if: github.event.pull_request.base.ref == 'desarrollo' || github.event.pull_request.base.ref == 'certificacion' || github.event.pull_request.base.ref == 'main'
+    runs-on: ubuntu-latest
+    steps:
+      # pull_request_target must execute only helper code from the trusted base.
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.event.pull_request.base.sha }}
+          persist-credentials: false
+      - name: Reject changes to CI, release, and security control definitions
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
+          PR_AUTHOR: ${{ github.event.pull_request.user.login }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          files_file="$RUNNER_TEMP/protected-workflow-files.json"
+          reviews_file="$RUNNER_TEMP/workflow-reviews.json"
+          gh api --paginate --slurp \
+            "repos/${REPOSITORY}/pulls/${PR_NUMBER}/files?per_page=100" > "$files_file"
+          protected_files_json="$(python3 scripts/security/protected_workflow_review.py \
+            --protected-files-json "$files_file")" || {
+              echo "::error::could not classify pull request files; refusing protected-control approval"
+              exit 1
+            }
+          if [ "$protected_files_json" = '[]' ]; then
+            current_head_sha="$(gh api "repos/${REPOSITORY}/pulls/${PR_NUMBER}" --jq '.head.sha')"
+            if [ "$current_head_sha" != "$PR_HEAD_SHA" ]; then
+              echo "::error::PR head changed while Protected Workflow Integrity was running"
+              exit 1
+            fi
+            echo "no protected workflow or security-control files changed"
+            exit 0
+          fi
+          printf 'review required for protected controls: %s\n' "$protected_files_json"
+          gh api --paginate --slurp \
+            "repos/${REPOSITORY}/pulls/${PR_NUMBER}/reviews?per_page=100" > "$reviews_file"
+          python3 scripts/security/protected_workflow_review.py \
+            --check-approval-json "$reviews_file" \
+            --head-sha "$PR_HEAD_SHA" \
+            --pr-author "$PR_AUTHOR"
+          current_head_sha="$(gh api "repos/${REPOSITORY}/pulls/${PR_NUMBER}" --jq '.head.sha')"
+          if [ "$current_head_sha" != "$PR_HEAD_SHA" ]; then
+            echo "::error::PR head changed while Protected Workflow Integrity was running"
+            exit 1
+          fi
