# Supabase Configuration - Free (desarrollo/certificacion)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
NEXT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
NEXT_SUPABASE_SECRET_KEY=sb_secret_example

# Admin BFF server-side only; each HMAC key must be distinct.
ADMIN_SESSION_ACTIVITY_HMAC_KEY=replace-with-another-32-random-bytes
ADMIN_RPC_GATEWAY_KEY_ID=local-k1
ADMIN_RPC_GATEWAY_HMAC_KEY=replace-with-at-least-32-random-bytes

# Manual and cross-environment tools (Free and Pro pairs must be distinct)
FREE_SUPABASE_URL=https://your-free-project-id.supabase.co
FREE_NEXT_SUPABASE_SECRET_KEY=sb_secret_free
PRO_SUPABASE_URL=https://your-pro-project-id.supabase.co
PRO_NEXT_SUPABASE_SECRET_KEY=sb_secret_pro

# Supabase Pro (production)
SUPABASE_PRO_PROJECT_REF=your-pro-project-ref
SUPABASE_MGMT_TOKEN=your-management-api-token

# Note: Get these from Supabase Dashboard > Settings > API
# NEVER commit real credentials to the repository
